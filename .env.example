# Copy to .env only to override these defaults. Do not commit .env.
API_PORT=8000
WEB_PORT=8080
VITE_API_BASE_URL=http://127.0.0.1:8000
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ARXIV_MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
ARXIV_MPNET_MODEL=sentence-transformers/all-mpnet-base-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true

# Default API build: official PyTorch CPU wheel index.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Used only with docker-compose.gpu.yml. Select a CUDA index compatible with the host.
TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu128
